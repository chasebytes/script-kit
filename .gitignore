# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE state
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Node.js and Electron dependencies/caches
**/node_modules/
**/.npm/
**/.cache/
**/.electron/
**/.vite/

# Generated application output
**/dist/
**/out/
**/coverage/
**/release/

# Package-manager and application logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment and secret files
.env
.env.*
!.env.example
!.env.*.example

# Temporary scaffolding and scratch directories
/.smoke/
/electron-template/.smoke/
**/.tmp/
*.tmp
*.temp

# Windows diagnostic captures and crash dumps
*.dmp
*.mdmp
*.evtx
*.etl

# Event-log analyzer reports (retain the directory placeholders)
/event-log-analyzer/output/*
!/event-log-analyzer/output/.gitignore
/gtaV/output/*
!/gtaV/output/.gitignore
